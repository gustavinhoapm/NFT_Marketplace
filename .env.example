# API base URL. Keep relative so requests stay same-origin and MSW can
# intercept them from the service worker.
VITE_API_BASE_URL=/api

# Realtime endpoint. Must stay a WebSocket URL: the MSW Socket.IO binding only
# intercepts WebSocket transport, never HTTP polling.
VITE_SOCKET_URL=http://localhost:5173

# "true" enables the MSW mock layer (service worker + socket binding).
# The public demo build ships with this enabled.
VITE_ENABLE_MOCKS=true

# Default deterministic mock scenario. See src/mocks/scenarios.ts for the list.
VITE_MOCK_SCENARIO=default
